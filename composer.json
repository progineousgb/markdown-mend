{
    "name": "progineousgb/markdown-mend",
    "description": "Repair broken markdown from language models before it is rendered.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "markdown",
        "laravel",
        "repair"
    ],
    "authors": [
        {
            "name": "Pro Gineous",
            "email": "dev@progineous.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "illuminate/container": "^12.0",
        "illuminate/support": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "illuminate/support": "Optional. Registers the Laravel service provider and Mend facade on Laravel 12 and 13 (^12.0 || ^13.0). The repair engine does not need Laravel."
    },
    "autoload": {
        "psr-4": {
            "Progineous\\Mend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Progineous\\Mend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Progineous\\Mend\\MendServiceProvider"
            ],
            "aliases": {
                "Mend": "Progineous\\Mend\\Facades\\Mend"
            }
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
